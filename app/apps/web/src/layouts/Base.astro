---
interface Props { title: string; }
const { title } = Astro.props;
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
:root{
  --primary:#181d26; --primary-active:#0d1218; --ink:#181d26; --body:#333840;
  --muted:#41454d; --hairline:#dddddd; --canvas:#ffffff; --surface-soft:#f8fafc;
  --surface-card:#f8fafc; --surface-dark:#181d26;
  --coral:#aa2d00; --forest:#0a2e0e; --cream:#f5e9d4; --peach:#fcab79;
  --mint:#a8d8c4; --yellow:#f4d35e; --mustard:#d9a441;
  --link:#1b61c9; --success:#006400; --success-border:#39bf45; --error:#ef4444;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--canvas);color:var(--body);font-size:14px;line-height:1.5}
h1,h2,h3{color:var(--ink);font-weight:400;letter-spacing:0}
a{color:var(--link)}
.wrap{max-width:1280px;margin:0 auto;padding:0 48px}
/* top nav */
.nav{height:64px;display:flex;align-items:center}
.nav .wrap{width:100%;display:flex;align-items:center;justify-content:space-between}
.brand{font-weight:500;color:var(--ink);text-decoration:none;font-size:16px}
.nav-links{display:flex;gap:24px;align-items:center}
.nav-links a{font-size:14px;font-weight:400;text-decoration:none;color:var(--body)}
.nav-links a:hover{color:var(--ink)}
/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;padding:16px 24px;border-radius:12px;font-size:16px;font-weight:500;text-decoration:none;cursor:pointer;border:1px solid transparent;transition:background-color 200ms}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:var(--primary-active)}
.btn-primary:disabled{background:var(--surface-soft);color:var(--muted);cursor:not-allowed}
.btn-secondary{background:var(--canvas);color:var(--ink);border-color:var(--hairline)}
.btn-secondary:hover{background:var(--surface-soft)}
/* cards */
.card{background:var(--surface-soft);border-radius:12px;padding:32px}
.card-white{background:var(--canvas);border:1px solid var(--hairline);border-radius:10px;padding:24px}
.badge{display:inline-block;background:var(--surface-soft);border-radius:9999px;padding:4px 12px;font-size:14px;font-weight:500;color:var(--ink)}
/* footer */
footer{background:var(--canvas);color:var(--body);padding:64px 0 32px;margin-top:96px;font-size:14px;border-top:1px solid var(--hairline)}
footer .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
footer strong{display:block;color:var(--ink);margin-bottom:12px;font-size:14px;font-weight:500}
footer a{color:var(--body);text-decoration:none;display:block;margin-bottom:8px}
footer a:hover{color:var(--ink)}
footer .fine{margin-top:48px;color:var(--muted);font-size:13px}
@media(max-width:768px){footer .cols{grid-template-columns:1fr 1fr}.wrap{padding:0 24px}}
</style>
</head>
<body>
<header class="nav"><div class="wrap">
<a class="brand" href="/">IG AutoDM</a>
<nav class="nav-links">
<a href="/dashboard">Dashboard</a>
<a href="/login">Log In</a>
<a class="btn btn-primary" href="/login" style="padding:12px 24px">Sign up for free</a>
</nav>
</div></header>
<main><slot /></main>
<footer><div class="wrap">
<div class="cols">
<div><strong>IG AutoDM</strong><a href="/">Home</a><a href="/dashboard">Dashboard</a><a href="/login">Sign in</a></div>
<div><strong>Product</strong><a href="/dashboard">Comment replies</a><a href="/dashboard">Comment to DM</a><a href="/dashboard">Per-video configs</a></div>
<div><strong>Resources</strong><a href="/">How it works</a><a href="/">Meta compliance</a></div>
<div><strong>Company</strong><a href="/">About</a><a href="/">Contact</a></div>
</div>
<p class="fine">© 2026 IG AutoDM. Built on the official Meta Graph API.</p>
</div></footer>
</body>
</html>
