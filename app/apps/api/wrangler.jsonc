{"$schema": "node_modules/wrangler/config-schema.json", "name": "ig-autodm-api", "main": "src/index.ts", "compatibility_date": "2025-07-18", "queues": {"producers": [{"binding": "COMMENT_QUEUE", "queue": "comment-events"}], "consumers": [{"queue": "comment-events", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3}]}, "triggers": {"crons": ["0 2 * * *", "* * * * *"]}, "vars": {"WEB_BASE": "https://ig-autodm.pages.dev", "API_BASE": "https://ig-autodm-api.admingamergully.workers.dev", "OAUTH_BASE_URL": "https://ig-autodm-api.admingamergully.workers.dev"}}